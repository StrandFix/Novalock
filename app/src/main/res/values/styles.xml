<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF27282A</item>
        <item name="android:colorBackground">#FF27282A</item>
        <item name="android:colorAccent">#FF78D4CA</item>
        <item name="android:statusBarColor">#FF222426</item>
        <item name="android:navigationBarColor">#FF222426</item>
        <item name="android:buttonStyle">@style/NovaButtonStyle</item>
    </style>

    <style name="NovaButtonStyle" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/nova_button</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFF0F5F5</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="PauseTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="LockTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- Translucent window: the app below stays visible (paused, not stopped), so it never
             re-creates its window/GL context because of the lock (which flashes and can crash
             some emulators). Apps that ignore onPause are stopped on demand by PauseActivity. -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
